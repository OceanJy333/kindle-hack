# input: ARMv7 kernel interfaces; output: station-only WPA supplicant; pos: independent Wi-Fi build configuration.
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_LIBNL32=y
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_TLS=openssl
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_PKCS12=y
CONFIG_SAE=y
CONFIG_IEEE80211R=y
CONFIG_IPV6=y
CONFIG_DEBUG_FILE=y
