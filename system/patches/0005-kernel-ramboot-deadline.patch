+/* input: RAM trial deadline and host acknowledgement; output: bounded trial;
+ * pos: early kernel recovery independent of driver and userspace progress.
+ */
+static unsigned int ocean_boot_timeout;
+core_param(ocean_boot_timeout, ocean_boot_timeout, uint, 0600);
+
+static void ocean_boot_expired(unsigned long unused)
+{
+	if (!ACCESS_ONCE(ocean_boot_timeout))
+		return;
+	pr_emerg("OCEAN_BOOT_TIMEOUT: host did not accept this boot\n");
+	local_irq_disable();
+	flush_cache_all();
+	outer_flush_all();
+	emergency_restart();
+}
+
+static DEFINE_TIMER(ocean_boot_timer, ocean_boot_expired, 0, 0);
+
+static int __init ocean_boot_guard_init(void)
+{
+	if (!ocean_boot_timeout)
+		return 0;
+	ocean_boot_timeout = clamp_t(unsigned int, ocean_boot_timeout, 5, 600);
+	mod_timer(&ocean_boot_timer, jiffies + ocean_boot_timeout * HZ);
+	pr_info("OCEAN_BOOT_GUARD: %u seconds, host acknowledgement required\n",
+		ocean_boot_timeout);
+	return 0;
+}
+early_initcall(ocean_boot_guard_init);
+
 int initcall_debug;
 core_param(initcall_debug, initcall_debug, bool, 0644);
 
